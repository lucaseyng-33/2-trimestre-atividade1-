/* Reset e Variáveis de Cores */
:root {
    --primary-color: #1e4620;
    --secondary-color: #2e7d32;
    --accent-color: #81c784;
    --bg-color: #f0f4f1;
    --card-bg: #ffffff;
    --text-color: #2c3e50;
    --danger-color: #e53935;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
}

body {
    background-color: var(--bg-color);
    color: var(--text-color);
    line-height: 1.6;
}

/* Cabeçalho Premium */
header {
    background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
    color: white;
    padding: 60px 20px;
    text-align: center;
    box-shadow: 0 4px 15px rgba(0,0,0,0.15);
}

.header-container h1 {
    font-size: 2.8rem;
    font-weight: 800;
    letter-spacing: -0.5px;
    margin-bottom: 8px;
}

.subtitle {
    font-size: 1.2rem;
    opacity: 0.9;
    margin-bottom: 15px;
}

.badge {
    display: inline-block;
    background: rgba(255, 255, 255, 0.2);
    padding: 6px 16px;
    border-radius: 20px;
    font-size: 0.95rem;
    font-weight: 600;
    backdrop-filter: blur(5px);
}

/* Layout Container */
.container {
    max-width: 1100px;
    margin: 40px auto;
    padding: 0 20px;
}

/* Cards de Conscientização */
.info-section {
    background: var(--card-bg);
    padding: 40px;
    border-radius: 16px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    margin-bottom: 40px;
}

.info-section h2 {
    color: var(--secondary-color);
    font-size: 1.8rem;
    margin-bottom: 15px;
}

.intro-text {
    font-size: 1.1rem;
    color: #546e7a;
    margin-bottom: 30px;
}

.grid-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 25px;
}

.card {
    background: #f8faf9;
    border-top: 5px solid var(--secondary-color);
    padding: 25px;
    border-radius: 8px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.card:hover {
    transform: translateY(-5px);
    box-shadow: 0 5px 15px rgba(0,0,0,0.05);
}

.card-icon {
    font-size: 2rem;
    margin-bottom: 10px;
}

.card h3 {
    color: var(--primary-color);
    margin-bottom: 12px;
    font-size: 1.3rem;
}

/* Seção do Jogo Melhorada */
.game-section {
    background: var(--card-bg);
    padding: 40px;
    border-radius: 16px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    text-align: center;
}

.game-section h2 {
    color: var(--secondary-color);
    margin-bottom: 10px;
}

.game-instruction {
    color: #616161;
    margin-bottom: 25px;
}

.game-stats {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-bottom: 20px;
}

.stat-box {
    background: #edf5ee;
    padding: 10px 20px;
    border-radius: 8px;
    font-weight: 700;
    font-size: 1.2rem;
    color: var(--primary-color);
    min-width: 140px;
}

/* Canvas Dinâmico */
#game-canvas {
    width: 100%;
    max-width: 600px;
    height: 420px;
    background: linear-gradient(to bottom, #a1c4fd 0%, #c2e9fb 100%);
    border: 6px solid var(--secondary-color);
    border-radius: 12px;
    margin: 0 auto;
    position: relative;
    overflow: hidden;
    cursor: none; /* Esconde o mouse padrão dentro da arena */
    transition: background-color 0.15s ease;
}

/* Efeitos de dano/pontuação na tela */
#game-canvas.hit-flash {
    background: #ffcdd2;
}

#game-canvas.score-flash {
    background: #c8e6c9;
}

.catcher {
    width: 90px;
    height: 22px;
    background: #5d4037;
    border-radius: 6px;
    box-shadow: inset 0 3px 0 #8d6e63, 0 4px 6px rgba(0,0,0,0.2);
    position: absolute;
    bottom: 12px;
    left: 255px;
}

.item {
    width: 35px;
    height: 35px;
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    filter: drop-shadow(0 2px 4px rgba(0,0,0,0.15));
}

/* Botão Modernizado */
.btn-game {
    background-color: var(--secondary-color);
    color: white;
    border: none;
    padding: 14px 40px;
    font-size: 1.1rem;
    font-weight: 600;
    border-radius: 30px;
    cursor: pointer;
    margin-top: 25px;
    box-shadow: 0 4px 10px rgba(46, 125, 50, 0.3);
    transition: all 0.2s ease;
}

.btn-game:hover {
    background-color: var(--primary-color);
    transform: scale(1.05);
}

/* Rodapé */
footer {
    background-color: var(--primary-color);
    color: white;
    text-align: center;
    padding: 25px 20px;
    margin-top: 60px;
    font-size: 0.95rem;
}